QLabel#title {
    color:rgb(159, 7, 161);
    border-radius: 10px;
    font-size: 30px;
    font-style: italic;
    padding-top: 0;
    padding-bottom: 0;
}


QPushButton {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #126e52, stop: 1 #7d057f);
    padding: 10px;
    margin-top: 15px;
    margin-bottom: 15px;
    border: 1px solid #26422e;
    border-radius: 20px;
}

QPushButton:disabled {
    background-color: #2e2d2d
}

QPushButton:hover {
    background-color: #21484a;
}


QListWidget {
    background-color: #161716;
    border: 2px solid #272928;
}

QListWidget::item:selected {
    background-color:rgb(185, 78, 187);
}


#btn-open {
    color: rgb(231, 231, 231);
    padding: 5px 10px;
    border-radius: 10px;
    margin-right: 15px;
}


QSlider{
    margin-top: 10px;
    margin-bottom: 10px;
}

QSlider::groove:horizontal {
    border: 1px solid  #7d057f;
    height: 4px;
}

QSlider::handle:horizontal {
    background-color:rgb(204, 206, 205);
    width: 20px;
    height: 20px;
    margin: -8px 0px;
    border-radius: 10px;
}

QSlider::handle:horizontal:hover {
    background-color: #126e52;
}

QSlider::add-page:horizontal {
    background-color:rgb(70, 73, 72);
}

QSlider::sub-page:horizontal {
    background-color: qlineargradient(spread:pad x1: 0, y1: 0, x2: 1, y2: 0 stop: 0 #126e52, stop: 1 #7d057f);
}